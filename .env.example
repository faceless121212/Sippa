# Copy to .env.local and fill in. Never commit real values.

# Public site URL (no domain yet — used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 1: waitlist storage; later: auth, DB, storage)
# Without these, the waitlist is saved to .data/waitlist.json in development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection for `npm run db:migrate` / `db:seed` (Settings → Database → Session pooler URI)
SUPABASE_DB_URL=

# Optional: override the local waitlist file path (used by e2e tests)
# WAITLIST_FILE=.data/waitlist.json

# fal.ai — character portraits (`npm run avatars`)
FAL_KEY=
# FAL_IMAGE_MODEL=fal-ai/flux/dev

# ---- Later phases ----
# ANTHROPIC_API_KEY=
# LLM_CHAT_MODEL=
# LLM_FAST_MODEL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Waitlist sign-ups allowed per IP per minute (default 5)
# WAITLIST_RATE_LIMIT_PER_MIN=5
